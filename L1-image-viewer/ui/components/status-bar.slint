import { FluentTokens } from "../tokens/fluent-tokens.slint";

export component StatusBar inherits Rectangle {
    height: 32px;
    background: FluentTokens.neutral-card;

    in property <string> file-name;
    in property <string> file-path;
    in property <float> zoom;
    in property <bool> fit-window;

    HorizontalLayout {
        padding-left: FluentTokens.space-lg;
        padding-right: FluentTokens.space-lg;
        alignment: space-between;

        Text {
            text: root.file-path == "" ? "就绪" : "已加载: " + root.file-name;
            font-size: 12px;
            color: FluentTokens.neutral-text-secondary;
            vertical-alignment: center;
        }

        Text {
            text: "缩放 " + Math.round(root.zoom * 100) + "%  |  " + (root.fit-window ? "适应窗口" : "原始尺寸");
            font-size: 12px;
            color: FluentTokens.neutral-text-tertiary;
            vertical-alignment: center;
        }
    }
}
