export global FluentTokens {
    // Neutral colors
    out property <color> neutral-bg: #fafafa;
    out property <color> neutral-card: #ffffff;
    out property <color> neutral-stroke: #e0e0e0;
    out property <color> neutral-stroke-subtle: #f0f0f0;
    out property <color> neutral-text-primary: #242424;
    out property <color> neutral-text-secondary: #616161;
    out property <color> neutral-text-tertiary: #9e9e9e;

    // Brand colors
    out property <color> brand-primary: #0078d4;
    out property <color> brand-hover: #106ebe;
    out property <color> brand-pressed: #005a9e;
    out property <color> brand-bg-subtle: #eff6fc;

    // Semantic colors
    out property <color> success: #0f7b0f;
    out property <color> warning: #9d5d00;
    out property <color> danger: #d13438;

    // Corner radius
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;

    // Spacing
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
}
